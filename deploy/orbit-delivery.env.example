# Orbit 平台生产环境配置（安装脚本会在缺少该文件时创建它）
NODE_ENV=production
PORT=8787

# 直接由 Node.js 提供 HTTPS 时启用；反向代理终止 TLS 时改为 false + TRUST_PROXY=true。
HTTPS_ENABLED=false
TRUST_PROXY=false
REQUIRE_HTTPS=false
# HTTPS_KEY_PATH=/absolute/path/to/orbit-key.pem
# HTTPS_CERT_PATH=/absolute/path/to/orbit-cert.pem

DB_PATH=/var/lib/orbit-delivery/orbit.db
VAULT_KEY=replace-with-at-least-32-random-characters

# 生产环境如需保留自动同步，可按实际凭据填写。
# FEISHU_AUTO_SYNC=true
# FEISHU_ACCESS_TOKEN=
# FEISHU_INGEST_TOKEN=
