{
  "name": "orbit-delivery-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "deliver:local": "tsx server/cli/localDelivery.ts",
    "feishu:agent": "tsx server/cli/feishuClientAgent.ts",
    "mcp:feishu": "tsx server/cli/feishuMcp.ts start",
    "mcp:feishu:status": "tsx server/cli/feishuMcp.ts status",
    "mcp:feishu:login": "tsx server/cli/feishuMcp.ts login",
    "mcp:feishu:logout": "tsx server/cli/feishuMcp.ts logout",
    "mcp:meegle": "tsx server/cli/meegleMcp.ts start",
    "mcp:meegle:status": "tsx server/cli/meegleMcp.ts status",
    "sync:feishu": "tsx server/cli/feishuSync.ts",
    "sync:feishu:watch": "tsx server/cli/feishuSync.ts --watch",
    "sync:feishu:snapshot": "tsx server/cli/feishuSync.ts --snapshot-only",
    "sync:feishu:snapshot:watch": "tsx server/cli/feishuSync.ts --snapshot-only --watch",
    "snapshot:from-db": "tsx server/cli/exportFeishuSnapshot.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:server": "node --import tsx --test server/tests/*.test.ts",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "preview": "npm run build && npm run start:server",
    "preview:web": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "optionalDependencies": {
    "@larksuiteoapi/lark-mcp": "^0.5.1"
  }
}
