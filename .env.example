PORT=8787
# 请求安全：启用后必须提供证书；生产环境也可由受信反向代理终止 TLS。
HTTPS_ENABLED=true
HTTPS_KEY_PATH=./data/tls/orbit-key.pem
HTTPS_CERT_PATH=./data/tls/orbit-cert.pem
HTTPS_CA_PATH=
HTTP_REDIRECT_PORT=8788
REQUIRE_HTTPS=true
TRUST_PROXY=false

# 登录认证：密码使用 scrypt 单向加盐哈希，会话 Cookie 为 HttpOnly。
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=true
DB_PATH=./data/orbit.db
VAULT_KEY=replace-with-at-least-32-random-characters
PIPELINE_STEP_MS=1800
# 编译系统网络：确保平台服务端能访问 Jenkins。若只能通过 HTTP 代理访问，可配置此项。
# BUILD_PROXY_URL=http://proxy.example.com:8080
# 服务端直连失败时，等待本机执行客户端返回编译结果的超时（毫秒）。
# BUILD_AGENT_TIMEOUT_MS=60000
FEISHU_PROJECT_BASE_URL=https://project.feishu.cn
FEISHU_SYNC_INTERVAL_MS=300000
FEISHU_AUTO_SYNC=true
FEISHU_PROJECT_KEY=rjcloud
FEISHU_ACCESS_TOKEN=
FEISHU_INGEST_TOKEN=
FEISHU_PLUGIN_ID=
FEISHU_PLUGIN_SECRET=
FEISHU_USER_KEY=
FEISHU_REQUIREMENT_TYPE_KEY=story
FEISHU_DEFECT_TYPE_KEY=issue
FEISHU_REQUIREMENT_PROJECT_FIELD=field_c7834f
FEISHU_DEFECT_PROJECT_FIELD=field_e1d325
FEISHU_DEFAULT_OWNER=飞书同步
FEISHU_CLOSE_TRANSITION_ID=
FEISHU_DEFAULT_REPO_ID=
FEISHU_DEFAULT_REPO_URL=http://cloudgit.rj.link/sme/sme-main.git
FEISHU_DEFAULT_REPO_BRANCH=dev-harvey
FEISHU_DEFAULT_REPO_LOCAL_PATH=

# 外部同步器（在能访问 project.feishu.cn 的机器上运行 npm run sync:feishu）
MEEGLE_BIN=meegle
MEEGLE_HOST=project.feishu.cn
CODEX_BIN=
PLATFORM_BASE_URL=https://8.145.45.84
PLATFORM_SYNC_TOKEN=
# 服务器临时交付回写地址；须是服务端可访问且证书可信的 HTTPS 平台地址。
CLOUD_DELIVERY_PLATFORM_URL=https://8.145.45.84
# 允许服务器临时检出的 Git 主机白名单，按仓库 URL 中的 hostname[:port] 精确匹配。
CLOUD_DELIVERY_GIT_HOSTS=cloudgit.rj.link
FEISHU_SYNC_STATE_PATH=./data/meegle-sync-state.json
FEISHU_SYNC_INTERVAL_MS=300000
FEISHU_SYNC_FULL=true
FEISHU_SYNC_OVERLAP_HOURS=48
FEISHU_SYNC_FETCH_DESCRIPTIONS=true
MEEGLE_RETRY_ATTEMPTS=3
MEEGLE_RETRY_DELAY_MS=1500
FEISHU_SNAPSHOT_PATH=./data/feishu-work-items.json
FEISHU_SNAPSHOT_ONLY=false

# 页面驱动的本机飞书同步代理（Mac 常驻使用 LaunchAgent；npm 命令仅用于开发调试）
FEISHU_AGENT_HOST=127.0.0.1
FEISHU_AGENT_PORT=18787
FEISHU_AGENT_HEARTBEAT_INTERVAL_MS=10000
FEISHU_AGENT_LOGIN_POLL_INTERVAL_MS=3000
FEISHU_AGENT_DELIVERY_TIMEOUT_MS=12600000
# 编码与 /aicr-commit 提交分别计时；外层代理预算应大于两者之和。
LOCAL_DELIVERY_CODEX_TIMEOUT_MS=9000000
LOCAL_DELIVERY_COMMIT_TIMEOUT_MS=1800000
FEISHU_AGENT_ALLOWED_ORIGINS=https://8.145.45.84,https://8.145.45.84:8787,https://localhost:8787,https://127.0.0.1:8787,https://localhost:4173,https://127.0.0.1:4173
# 可选：为独立配置/端口的代理固定唯一标识和页面展示名；首次启动会自动生成 UUID 和 hostname。
FEISHU_AGENT_CLIENT_ID=
FEISHU_AGENT_CLIENT_NAME=
# 不要在仓库中填写真实凭据；代理首次绑定后会自动写入用户目录配置文件。
FEISHU_AGENT_CONFIG_PATH=
# 可选：当前客户端仓库 ID 到绝对路径的 JSON 映射，覆盖平台共享仓库路径。
FEISHU_AGENT_REPO_PATHS=

# 飞书 OpenAPI MCP（供本机 Codex 读取飞书文档/Wiki/IM 等；不用于 Meegle 工作项同步）
# 配置文件包含 App Secret，权限保持 0600，且不要提交到仓库。
FEISHU_MCP_ENABLED=true
FEISHU_MCP_REQUIRED=false
FEISHU_MCP_BIN=
FEISHU_MCP_CONFIG_PATH=

# Meegle MCP（本机 Codex 实时只读查询 project.feishu.cn 需求/缺陷）
# 复用本机已登录的 meegle CLI；不会把 Token 下发给浏览器或写入仓库。
MEEGLE_MCP_ENABLED=true
MEEGLE_MCP_REQUIRED=false
MEEGLE_MCP_TSX_BIN=
MEEGLE_MCP_SCRIPT=

# 前端通过登录保护的同源 API 轮询数据库中的飞书工作项快照。
# FEISHU_SNAPSHOT_PATH 只用于 CLI 导出 JSON 备份，不再作为公开静态资源。
VITE_FEISHU_SNAPSHOT_URL=/api/feishu/snapshot
VITE_FEISHU_SNAPSHOT_REFRESH_MS=60000
VITE_API_PROXY_TARGET=https://127.0.0.1:8787

# 浏览器通过同源 /api 访问平台；不要配置浏览器直连回环代理地址。
# 页面通过同源 HTTPS API 访问平台，不直接请求客户端回环地址。
